{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["id", "schemaVersion", "setId", "name", "text", "overrides", "tags", "characterMechanics", "characterEffects", "playerVisible", "retired", "updatedAt"],
  "properties": {
    "id": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "schemaVersion": { "$ref": "homebrew-common.schema.json#/$defs/schemaVersion" },
    "setId": { "$ref": "homebrew-common.schema.json#/$defs/setRef" },
    "name": { "$ref": "homebrew-common.schema.json#/$defs/name" },
    "text": { "$ref": "homebrew-common.schema.json#/$defs/markdown" },
    "overrides": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "itemType": { "$ref": "homebrew-common.schema.json#/$defs/itemType" },
        "rarity": { "$ref": "homebrew-common.schema.json#/$defs/rarity" },
        "attunement": { "type": "boolean" },
        "bodyPlacements": { "$ref": "homebrew-common.schema.json#/$defs/bodyPlacements" },
        "weightLb": { "$ref": "homebrew-common.schema.json#/$defs/weightLb" }
      }
    },
    "tags": { "$ref": "homebrew-common.schema.json#/$defs/tags" },
    "characterMechanics": { "$ref": "homebrew-common.schema.json#/$defs/mechanics" },
    "characterEffects": { "$ref": "homebrew-common.schema.json#/$defs/effects" },
    "playerVisible": { "type": "boolean" },
    "retired": { "type": "boolean" },
    "updatedAt": { "$ref": "homebrew-common.schema.json#/$defs/updatedAt" },
    "grants": { "$ref": "homebrew-common.schema.json#/$defs/itemGrants" },
    "attunementPrerequisites": { "$ref": "homebrew-common.schema.json#/$defs/attunementRequirement" },
    "container": { "$ref": "homebrew-common.schema.json#/$defs/container" },
    "baseItem": { "$ref": "homebrew-common.schema.json#/$defs/baseItem" }
  },
  "allOf": [
    {
      "if": { "properties": { "characterMechanics": { "const": "narrative" } } },
      "then": { "properties": { "characterEffects": { "maxItems": 0 } }, "not": { "anyOf": [{ "required": ["grants"] }, { "required": ["baseItem"], "properties": { "baseItem": { "required": ["bonus"] } } }] } }
    },
    {
      "if": { "properties": { "characterMechanics": { "const": "complete" } } },
      "then": { "anyOf": [{ "properties": { "characterEffects": { "minItems": 1 } } }, { "required": ["grants"] }, { "required": ["baseItem"], "properties": { "baseItem": { "required": ["bonus"] } } }] }
    }
  ]
}
