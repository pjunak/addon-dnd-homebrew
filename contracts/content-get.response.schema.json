{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "setId", "revision", "record"],
  "properties": {
    "contractVersion": { "const": "content-record.v1" },
    "setId": { "const": "rules" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "record": { "$ref": "content-record.schema.json" }
  }
}
