{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["id", "schemaVersion", "subclassId", "classId", "withdrawn", "records"],
  "properties": {
    "id": { "$ref": "#/$defs/recordId" },
    "schemaVersion": { "$ref": "homebrew-common.schema.json#/$defs/schemaVersion" },
    "subclassId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "classId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "withdrawn": { "type": "boolean" },
    "records": {
      "type": "array", "minItems": 1, "maxItems": 41,
      "items": { "anyOf": [{ "$ref": "#/$defs/subclassRecord" }, { "$ref": "#/$defs/featureRecord" }] }
    }
  },
  "$defs": {
    "recordId": { "type": "string", "maxLength": 67, "pattern": "^hb\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subclassRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "name", "edition", "book", "classId", "subclassLevel", "features", "spells", "text"],
      "properties": {
        "kind": { "const": "subclass" },
        "id": { "$ref": "#/$defs/recordId" },
        "name": { "$ref": "homebrew-common.schema.json#/$defs/name" },
        "edition": { "const": "2024" },
        "book": { "const": "homebrew" },
        "classId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
        "subclassLevel": { "$ref": "homebrew-common.schema.json#/$defs/level" },
        "features": {
          "type": "array", "maxItems": 40,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["level", "id", "name"],
            "properties": {
              "level": { "$ref": "homebrew-common.schema.json#/$defs/level" },
              "id": { "$ref": "homebrew-common.schema.json#/$defs/id" },
              "name": { "$ref": "homebrew-common.schema.json#/$defs/name" }
            }
          }
        },
        "spells": { "type": "array", "maxItems": 30, "items": { "$ref": "engine-grants.schema.json#/$defs/grants/$defs/SpellGrantDecl" } },
        "grants": { "$ref": "engine-grants.schema.json#/$defs/grants" },
        "classResources": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "engine-grants.schema.json#/$defs/grants/$defs/ResourceGrant" } },
        "tableColumns": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "homebrew-common.schema.json#/$defs/tableColumn" } },
        "spellcasting": { "$ref": "homebrew-common.schema.json#/$defs/subclassSpellcasting" },
        "progression": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "homebrew-common.schema.json#/$defs/castingRow" } },
        "excerpt": { "$ref": "homebrew-common.schema.json#/$defs/excerpt" },
        "text": { "$ref": "homebrew-common.schema.json#/$defs/markdown" }
      },
      "dependentRequired": { "progression": ["spellcasting"], "spellcasting": ["progression"] }
    },
    "featureRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "name", "edition", "book", "classId", "subclassId", "level", "localId", "text"],
      "properties": {
        "kind": { "const": "feature" },
        "id": { "type": "string", "maxLength": 132, "pattern": "^hb\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "$ref": "homebrew-common.schema.json#/$defs/name" },
        "edition": { "const": "2024" },
        "book": { "const": "homebrew" },
        "classId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
        "subclassId": { "$ref": "#/$defs/recordId" },
        "level": { "$ref": "homebrew-common.schema.json#/$defs/level" },
        "localId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
        "grants": { "$ref": "engine-grants.schema.json#/$defs/grants" },
        "excerpt": { "$ref": "homebrew-common.schema.json#/$defs/excerpt" },
        "text": { "$ref": "homebrew-common.schema.json#/$defs/markdown" }
      }
    }
  }
}
