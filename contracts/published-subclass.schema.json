{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["id", "schemaVersion", "subclassId", "classId", "withdrawn", "records"],
  "properties": {
    "id": { "type": "string", "maxLength": 67, "pattern": "^hb\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "$ref": "homebrew-common.schema.json#/$defs/schemaVersion" },
    "subclassId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "classId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "withdrawn": { "type": "boolean" },
    "records": {
      "type": "array", "minItems": 1, "maxItems": 41,
      "items": {
        "allOf": [
          { "$ref": "rule-record.schema.json" },
          { "type": "object", "required": ["kind", "id", "name", "edition", "book", "classId", "text"], "properties": { "kind": { "enum": ["subclass", "feature"] }, "edition": { "const": "2024" }, "book": { "const": "homebrew" } } }
        ]
      }
    }
  }
}
