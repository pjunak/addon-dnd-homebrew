{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["id", "schemaVersion", "name", "classId", "subclassLevel", "text", "excerpt", "spells", "classResources", "tableColumns", "features", "updatedAt"],
  "properties": {
    "id": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "schemaVersion": { "$ref": "homebrew-common.schema.json#/$defs/schemaVersion" },
    "name": { "$ref": "homebrew-common.schema.json#/$defs/name" },
    "classId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "subclassLevel": { "$ref": "homebrew-common.schema.json#/$defs/level" },
    "text": { "$ref": "homebrew-common.schema.json#/$defs/markdown" },
    "excerpt": { "$ref": "homebrew-common.schema.json#/$defs/excerpt" },
    "spells": { "type": "array", "maxItems": 30, "items": { "$ref": "rule-record.schema.json#/$defs/grants/$defs/SpellGrantDecl" } },
    "grants": { "$ref": "rule-record.schema.json#/$defs/grants" },
    "classResources": { "type": "array", "maxItems": 10, "items": { "$ref": "rule-record.schema.json#/$defs/grants/$defs/ResourceGrant" } },
    "tableColumns": { "type": "array", "maxItems": 10, "items": { "$ref": "homebrew-common.schema.json#/$defs/tableColumn" } },
    "spellcasting": { "$ref": "homebrew-common.schema.json#/$defs/subclassSpellcasting" },
    "progression": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "homebrew-common.schema.json#/$defs/castingRow" } },
    "features": { "type": "array", "maxItems": 40, "items": { "$ref": "homebrew-common.schema.json#/$defs/feature" } },
    "updatedAt": { "$ref": "homebrew-common.schema.json#/$defs/updatedAt" }
  },
  "dependentRequired": { "progression": ["spellcasting"], "spellcasting": ["progression"] }
}
