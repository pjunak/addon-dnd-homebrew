{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "value"],
  "properties": {
    "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "value": {
      "anyOf": [
        { "$ref": "published-record.schema.json#/properties/record" },
        { "$ref": "published-subclass.schema.json#/$defs/subclassRecord" },
        { "$ref": "published-subclass.schema.json#/$defs/featureRecord" },
        { "$ref": "published-feat.schema.json#/$defs/featRecord" },
        { "$ref": "published-spell.schema.json#/$defs/spellRecord" },
        { "$ref": "published-species.schema.json#/$defs/speciesRecord" },
        { "$ref": "published-background.schema.json#/$defs/backgroundRecord" }
      ]
    }
  }
}
