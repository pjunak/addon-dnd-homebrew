{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["id", "schemaVersion", "itemId", "setId", "setName", "playerVisible", "retired", "withdrawn", "record"],
  "properties": {
    "id": { "type": "string", "maxLength": 67, "pattern": "^hb\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "$ref": "homebrew-common.schema.json#/$defs/schemaVersion" },
    "itemId": { "$ref": "homebrew-common.schema.json#/$defs/id" },
    "setId": { "$ref": "homebrew-common.schema.json#/$defs/setRef" },
    "setName": { "anyOf": [{ "const": "" }, { "$ref": "homebrew-common.schema.json#/$defs/name" }] },
    "playerVisible": { "type": "boolean" },
    "retired": { "type": "boolean" },
    "withdrawn": { "type": "boolean" },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "name", "edition", "book", "itemType", "rarity", "attunement", "tags", "text", "characterMechanics", "characterEffects"],
      "properties": {
        "kind": { "const": "magic-item" },
        "id": { "type": "string", "maxLength": 67, "pattern": "^hb\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 243 },
        "edition": { "const": "2024" },
        "book": { "const": "homebrew" },
        "itemType": { "$ref": "homebrew-common.schema.json#/$defs/itemType" },
        "rarity": { "$ref": "homebrew-common.schema.json#/$defs/rarity" },
        "attunement": { "type": "boolean" },
        "tags": { "type": "array", "maxItems": 42, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "text": { "type": "string", "maxLength": 61000 },
        "characterMechanics": { "$ref": "homebrew-common.schema.json#/$defs/mechanics" },
        "characterEffects": { "$ref": "homebrew-common.schema.json#/$defs/effects" },
        "bodyPlacements": { "allOf": [{ "$ref": "homebrew-common.schema.json#/$defs/bodyPlacements" }, { "minItems": 1 }] },
        "grants": { "$ref": "homebrew-common.schema.json#/$defs/recordGrants" }
      },
      "allOf": [
        {
          "if": { "properties": { "characterMechanics": { "const": "narrative" } } },
          "then": { "properties": { "characterEffects": { "maxItems": 0 } }, "not": { "required": ["grants"] } }
        },
        {
          "if": { "properties": { "characterMechanics": { "const": "complete" } } },
          "then": { "anyOf": [{ "properties": { "characterEffects": { "minItems": 1 } } }, { "required": ["grants"] }] }
        }
      ]
    }
  }
}
