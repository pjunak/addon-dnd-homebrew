{
  "$schema": "../ttrpg-codex/contracts/addons/v3/manifest.schema.json",
  "packageFormat": 1,
  "id": "dnd-homebrew",
  "name": "D&D Homebrew Items",
  "version": "1.0.0",
  "description": "DM-authored custom items and item classes served to character sheets as rules data.",
  "license": "MIT",
  "compatibility": {
    "host": ">=2.0.0 <3.0.0",
    "addonApi": "^3.0.0",
    "workerProtocol": "^1.0.0"
  },
  "capabilities": {
    "required": ["data.transactions", "services.own", "ui.contributions",
      "ui.controls.v1", "ui.markdown", "worker.native"],
    "optional": []
  },
  "runtime": {
    "ui": { "mode": "integrated", "entry": "web/index.js", "styles": ["web/index.css"] },
    "worker": {
      "type": "native",
      "protocol": "^1.0.0",
      "entrypoints": {
        "windows-amd64": "worker/windows-amd64/dnd-homebrew.exe",
        "linux-amd64": "worker/linux-amd64/dnd-homebrew",
        "linux-arm64": "worker/linux-arm64/dnd-homebrew"
      }
    }
  },
  "permissions": [],
  "rules": { "supports": ["dnd-2024"] },
  "contributions": [
    { "id": "homebrew.route", "surface": "route", "label": "Homebrew Items", "roles": ["dm"], "config": { "path": "homebrew", "labels": { "cs": "Vlastní předměty" } } },
    { "id": "homebrew.sidebar", "surface": "sidebar", "label": "Homebrew Items", "roles": ["dm"], "order": 220, "config": { "route": "homebrew.route", "labels": { "cs": "Vlastní předměty" } } },
    { "id": "gallery.route", "surface": "route", "label": "Item Gallery", "roles": ["dm", "player"], "config": { "path": "homebrew-gallery", "labels": { "cs": "Galerie předmětů" } } },
    { "id": "gallery.sidebar", "surface": "sidebar", "label": "Item Gallery", "roles": ["dm", "player"], "order": 221, "config": { "route": "gallery.route", "labels": { "cs": "Galerie předmětů" } } },
    { "id": "homebrew.wiki", "surface": "wiki-kind", "label": "Homebrew items", "roles": ["dm", "player"], "config": { "contractVersion": 1, "kinds": ["magic-item"], "search": true } }
  ],
  "collections": [
    { "id": "homebrew_classes", "keyed": true, "visibility": "dm", "schema": "contracts/homebrew-class.schema.json", "schemaVersion": "1.0.0" },
    { "id": "homebrew_items", "keyed": true, "visibility": "dm", "schema": "contracts/homebrew-item.schema.json", "schemaVersion": "1.0.0", "indexes": [{ "path": "/classId" }] },
    { "id": "homebrew_published", "keyed": true, "visibility": "public", "schema": "contracts/published-record.schema.json", "schemaVersion": "1.0.0", "indexes": [{ "path": "/classId" }, { "path": "/playerVisible" }] },
    { "id": "homebrew_meta", "keyed": true, "visibility": "public", "schema": "contracts/publish-meta.schema.json", "schemaVersion": "1.0.0" }
  ],
  "services": {
    "provides": [
      { "contract": "dnd5e.rules-data", "version": "3.0.0", "transport": "worker", "schema": "contracts/rules-data.service.json" },
      { "contract": "codex.import-adapter", "version": "2.0.0", "transport": "worker", "schema": "contracts/import-adapter.service.json" }
    ]
  }
}
