// Keeps src/grants-schema.ts a copy of the Engine's grants vocabulary in
// contracts/engine-grants.schema.json, so the editor and its checks in the
// browser use the same rules as the worker.
//   node tools/grants-schema.mts check   fail when the copy differs
//   node tools/grants-schema.mts sync    rewrite the copy
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = fileURLToPath(new URL("../", import.meta.url));
const source = resolve(root, "contracts/engine-grants.schema.json");
const target = resolve(root, "src/grants-schema.ts");
const mode = process.argv[2];
if (mode !== "check" && mode !== "sync") {
  console.error("usage: node tools/grants-schema.mts check|sync");
  process.exit(2);
}

const record = JSON.parse(readFileSync(source, "utf8")) as { $defs?: { grants?: unknown } };
if (!record.$defs?.grants)
  throw new Error("contracts/engine-grants.schema.json has no $defs.grants");
const expected = [
  "// Generated by tools/grants-schema.mts from contracts/engine-grants.schema.json",
  "// ($defs.grants); do not edit. References keep that file's form,",
  '// "#/$defs/grants/$defs/<name>".',
  'import type { SchemaNode } from "./schema.js";',
  "",
  `export const grantsSchema: SchemaNode = ${JSON.stringify(record.$defs.grants, null, 2)};`,
  "",
].join("\n");
let current: string | undefined;
try {
  current = readFileSync(target, "utf8");
} catch {
  current = undefined;
}
if (current === expected) console.log("src/grants-schema.ts matches the Engine grants copy.");
else if (mode === "sync") {
  writeFileSync(target, expected);
  console.log("Rewrote src/grants-schema.ts from the Engine grants copy.");
} else {
  console.error(
    "src/grants-schema.ts differs from the Engine grants copy; run npm run sync:grants-schema.",
  );
  process.exitCode = 1;
}
